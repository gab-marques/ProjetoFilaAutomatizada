{
  "name": "Fila Inteligente - 1 Min Tick & Retrain",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Every 1 Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tick-secret",
              "value": "={{$env.TICK_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Trigger /api/tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * *"
            }
          ]
        }
      },
      "id": "3",
      "name": "Daily at 04:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/retrain",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-tick-secret",
              "value": "={{$env.TICK_SECRET}}"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Trigger /api/retrain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 500]
    }
  ],
  "connections": {
    "Every 1 Minute": {
      "main": [
        [
          {
            "node": "Trigger /api/tick",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily at 04:00 AM": {
      "main": [
        [
          {
            "node": "Trigger /api/retrain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
